[Unit]
Description=LaundryManagement Spring Boot API
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=laundry
Group=laundry
WorkingDirectory=/opt/laundry
EnvironmentFile=/opt/laundry/laundry.env
ExecStart=/usr/bin/java -jar /opt/laundry/laundry-api.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
